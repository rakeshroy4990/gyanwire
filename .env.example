# Copy this file to .env and fill in your keys.
# Never commit .env.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
UI_PORT=5180
UI_ORIGIN=http://localhost:5180

# gyanwire-server (Spring Boot) — sole API
GYANWIRE_SERVER_PORT=8080
# Cloud Run sets PORT; local bootRun uses GYANWIRE_SERVER_PORT.
# PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/gyanwire
SPRING_DATASOURCE_USERNAME=gyanwire
SPRING_DATASOURCE_PASSWORD=gyanwire
APP_PERSISTENCE_PROVIDER=postgres
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,https://localhost:*

# -----------------------------------------------------------------------------
# Optional LLM — sharpens the query and can nudge pointer rankings
# -----------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional self-hosted SearXNG instance for extra discovery results.
SEARXNG_URL=

# -----------------------------------------------------------------------------
# JWT + cookies (tokens only in httpOnly cookies — never localStorage)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret
# Optional explicit Spring alias:
# APP_AUTH_JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=43200
JWT_REFRESH_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
# AUTH_COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# Google Identity Services (OAuth Web client ID)
# -----------------------------------------------------------------------------
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Backend origin for the Vue client (baked into the Vite bundle).
# Local:
VITE_BACKEND_URL=http://localhost:8080
# Cloud / Firebase Hosting production build (.env.production):
# VITE_BACKEND_URL=https://gyanwire-r5eanyyt6a-el.a.run.app

# -----------------------------------------------------------------------------
# Razorpay Subscriptions
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_ANNUAL=
RAZORPAY_PLAN_TEAM_MONTHLY=
# RAZORPAY_PLAN_TEAM_ANNUAL=
