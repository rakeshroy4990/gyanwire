# Copy this file to .env and fill in your keys.
# Never commit .env.

# -----------------------------------------------------------------------------
# Optional LLM — sharpens the query and can nudge pointer rankings
# Leave blank to use the local Gyanwire engine only.
# Works with OpenAI-compatible APIs (OpenAI, Groq, OpenRouter, Azure, etc.)
# -----------------------------------------------------------------------------
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional self-hosted SearXNG instance for extra discovery results.
# Example: http://localhost:8080
SEARXNG_URL=

# -----------------------------------------------------------------------------
# Server / UI ports
# (5173 is commonly used by other apps; Gyanwire defaults elsewhere)
# -----------------------------------------------------------------------------
UI_PORT=5180
PORT=3010
HOST=0.0.0.0
UI_ORIGIN=http://localhost:5180

# -----------------------------------------------------------------------------
# Auth (PostgreSQL + JWT + Google Sign-In)
# Same datasource variables as hospital Spring Boot backend.
# -----------------------------------------------------------------------------
APP_PERSISTENCE_PROVIDER=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=
# Optional pool size (mirrors hospital)
# SPRING_DATASOURCE_MAX_POOL_SIZE=10
DATABASE_SSL=true
AUTH_AUTO_MIGRATE=false
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=43200
JWT_REFRESH_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# Google Identity Services (OAuth Web client ID)
# Create at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:5180
VITE_GOOGLE_OAUTH_CLIENT_ID=
