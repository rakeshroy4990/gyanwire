# Copy this file to .env and fill in your keys.
# Never commit .env.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3010
HOST=0.0.0.0
UI_PORT=5180
UI_ORIGIN=http://localhost:5180

# -----------------------------------------------------------------------------
# Optional LLM — sharpens the query and can nudge pointer rankings
# Leave blank to use the local Gyanwire engine only.
# Works with OpenAI-compatible APIs (OpenAI, Groq, OpenRouter, Azure, etc.)
# -----------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional self-hosted SearXNG instance for extra discovery results.
# Example: http://localhost:8080
SEARXNG_URL=

# -----------------------------------------------------------------------------
# Auth persistence (PostgreSQL)
# Prefer DATABASE_URL for local/docker. Hospital Spring-style vars are still
# accepted for compatibility until Step 1 migrates to GYANWIRE_DATABASE_URL.
# -----------------------------------------------------------------------------
APP_PERSISTENCE_PROVIDER=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gyanwire
DATABASE_SSL=false
DATABASE_POOL_MAX=5
# SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/postgres
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
# SPRING_DATASOURCE_MAX_POOL_SIZE=10
AUTH_AUTO_MIGRATE=false

# -----------------------------------------------------------------------------
# JWT + cookies (tokens only in httpOnly cookies — never localStorage)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=43200
JWT_REFRESH_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
# AUTH_COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# Google Identity Services (OAuth Web client ID)
# Create at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:5180
# -----------------------------------------------------------------------------
VITE_GOOGLE_OAUTH_CLIENT_ID=
