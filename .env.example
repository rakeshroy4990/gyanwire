# Copy this file to .env and fill in your keys.
# Never commit .env.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
UI_PORT=5180
UI_ORIGIN=http://localhost:5180

# gyanwire-server (Spring Boot) — sole API
GYANWIRE_SERVER_PORT=8080
# Cloud Run sets PORT; local bootRun uses GYANWIRE_SERVER_PORT.
# PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/gyanwire
SPRING_DATASOURCE_USERNAME=gyanwire
SPRING_DATASOURCE_PASSWORD=gyanwire
APP_PERSISTENCE_PROVIDER=postgres
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,https://localhost:*

# -----------------------------------------------------------------------------
# Optional LLM — sharpens the query and can nudge pointer rankings
# -----------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Pro and Team use this for idea and outline while the tier router is off.
LLM_MODEL_HIGH=gpt-4o-mini
# Phase-1 router. Defaults keep Cloud Run on gpt-4o-mini until a stage flag is turned on.
LLM_ROUTER_ENABLED=false
LLM_SHADOW=false
LLM_LIGHT_MODEL=gpt-6-luna
LLM_MAIN_MODEL=gpt-6.1-sol
LLM_DEEP_MODEL=gpt-6.1-sol
FX_INR_PER_USD=96.5
LLM_DAILY_CAP_INR=300
LLM_STAGE_SHARPEN=false
LLM_STAGE_WHYLINES=false
LLM_STAGE_RERANK=false
LLM_STAGE_PLAN_A=false
LLM_STAGE_PLAN_B=false
LLM_STAGE_WHATIF=false
LLM_STAGE_NEWS_CLASSIFY=false

# News engine. Dev profile (scripts/start-gyanwire-server.sh) turns startup ingest on.
GYANWIRE_NEWS_INGEST_ENABLED=true
GYANWIRE_NEWS_INGEST_ON_STARTUP=false
GYANWIRE_NEWS_INGEST_INITIAL_DELAY=PT5M
GYANWIRE_NEWS_INGEST_INTERVAL=PT30M
GYANWIRE_NEWS_POLL_MINUTES=30
GYANWIRE_NEWS_CLASSIFY_LLM=false
GYANWIRE_NEWS_SEED_ALLOWED=false
GYANWIRE_NEWS_SEED_ON_EMPTY=false
GYANWIRE_NEWS_JOBS_ENABLED=false

# Optional self-hosted SearXNG instance for extra discovery results.
SEARXNG_URL=

# -----------------------------------------------------------------------------
# JWT + cookies (tokens only in httpOnly cookies — never localStorage)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret
# Optional explicit Spring alias:
# APP_AUTH_JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=43200
JWT_REFRESH_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
# AUTH_COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# Google Identity Services (OAuth Web client ID)
# -----------------------------------------------------------------------------
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Backend origin for the Vue client (baked into the Vite bundle).
# Local:
VITE_BACKEND_URL=http://localhost:8080
# Cloud / Firebase Hosting production build (.env.production):
# VITE_BACKEND_URL=https://gyanwire-r5eanyyt6a-el.a.run.app

# -----------------------------------------------------------------------------
# Razorpay Subscriptions
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_ANNUAL=
RAZORPAY_PLAN_TEAM_MONTHLY=
# RAZORPAY_PLAN_TEAM_ANNUAL=
# Student checkout stays disabled until this Razorpay plan id is set.
# RAZORPAY_PLAN_STUDENT_MONTHLY=

# MCP server key. Requests send it as X-Api-Key. Tool output is untrusted.
MCP_API_KEY=

# Nightly digest job. Leave false unless this instance should send mail.
APP_JOBS_ENABLED=false
