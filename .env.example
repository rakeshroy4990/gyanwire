# Copy this file to .env and fill in your keys.
# Never commit .env.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3010
HOST=0.0.0.0
UI_PORT=5180
UI_ORIGIN=http://localhost:5180

# -----------------------------------------------------------------------------
# Optional LLM — sharpens the query and can nudge pointer rankings
# Leave blank to use the local Gyanwire engine only.
# Works with OpenAI-compatible APIs (OpenAI, Groq, OpenRouter, Azure, etc.)
# -----------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional self-hosted SearXNG instance for extra discovery results.
# Example: http://localhost:8080
SEARXNG_URL=

# -----------------------------------------------------------------------------
# Auth persistence — Gyanwire-owned PostgreSQL
# Prefer GYANWIRE_DATABASE_URL. Local docker-compose maps host 5433 → 5432.
# -----------------------------------------------------------------------------
APP_PERSISTENCE_PROVIDER=postgres
GYANWIRE_DATABASE_URL=postgresql://gyanwire:gyanwire@localhost:5433/gyanwire
# DATABASE_URL=postgresql://gyanwire:gyanwire@localhost:5433/gyanwire
DATABASE_SSL=false
DATABASE_POOL_MAX=5
AUTH_AUTO_MIGRATE=true

# Optional one-off export from a legacy shared DB (server/scripts/export-gyanwire-users.js)
# EXPORT_SOURCE_DATABASE_URL=postgresql://...

# -----------------------------------------------------------------------------
# JWT + cookies (tokens only in httpOnly cookies — never localStorage)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=43200
JWT_REFRESH_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
# AUTH_COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# Google Identity Services (OAuth Web client ID)
# Create at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins:
#   http://localhost:5180
#   https://gyanwire-a4293.web.app
#   https://gyanwire-a4293.firebaseapp.com
# -----------------------------------------------------------------------------
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Production Firebase UI → Cloud Run API (leave blank for local Vite proxy)
# VITE_API_BASE_URL=https://gyanwire-r5eanyyt6a-el.a.run.app

# -----------------------------------------------------------------------------
# Razorpay Subscriptions (test mode first)
# Dashboard → Settings → API Keys / Webhooks / Plans
# Local webhook: tunnel https URL → POST /api/billing/webhook
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_ANNUAL=
RAZORPAY_PLAN_TEAM_MONTHLY=
# RAZORPAY_PLAN_TEAM_ANNUAL=

