# Optional local overrides (root ../.env is also loaded by bootRun).
GYANWIRE_SERVER_PORT=8080
APP_PERSISTENCE_PROVIDER=postgres

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/gyanwire
SPRING_DATASOURCE_USERNAME=gyanwire
SPRING_DATASOURCE_PASSWORD=gyanwire

APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,https://localhost:*
JWT_SECRET=change-me-to-a-long-random-secret
